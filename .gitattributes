# Normalise line endings so the repo stays LF regardless of who checks it out.
# Without this, a Windows checkout rewrites every file and diffs become noise.
* text=auto eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary

# Generated — collapse in diffs and mark so review focuses elsewhere.
src/data/catalog.json linguist-generated=true
package-lock.json     linguist-generated=true

# The extraction mirror is reference material, not authored code.
extraction/** linguist-vendored=true
