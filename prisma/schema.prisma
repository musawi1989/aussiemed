// AussieMed — database schema
//
// Design notes that apply throughout:
//
// MONEY is stored as an integer number of fils (1 AED = 100 fils), never a
// float or a Decimal. SQLite has no native decimal type, so Prisma's Decimal
// falls back to a float there, and a float is not something to keep a tax
// invoice in. Integers are exact, behave identically on SQLite and Postgres,
// and the storefront already rounds to 2 decimals. Every money field is named
// *Fils so a raw number can never be mistaken for AED.
//
// ENUMS are modelled as String with the permitted values listed in a comment.
// SQLite does not support native enums, and the spec requires the datasource
// to be swappable to Postgres without rewriting SQL. Validation lives in the
// service layer (zod) rather than the database.
//
// JSON is stored as String for the same portability reason.
//
// A SKU is the purchasable thing, not the product. The same line sells by the
// box and by the carton at different prices, so unit of measure lives on the
// SKU. This is the single most important shape in the schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// People and organisations
// ---------------------------------------------------------------------------

/// role: Admin | Supplier | Customer
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Optional sign-in handle. Staff accounts sign in as "admin" or
  /// "supplier1" rather than by email, so login accepts either.
  username     String? @unique
  passwordHash String?
  role         String  @default("Customer")
  name         String
  phone        String?
  isVerified   Boolean @default(false)
  isDisabled   Boolean @default(false)

  /// Email OTP. The spec's sign-in is a code, not a password.
  otpCode      String?
  otpExpiresAt DateTime?

  supplier       Supplier?
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  sessions     Session[]
  orders       Order[]
  quotes       QuoteRequest[]
  wishlist     WishlistItem[]
  carts        Cart[]
  enquiries    Enquiry[]
  notifies     NotifySubscription[]
  auditEntries AuditLog[]     @relation("AuditActor")

  changesRequested AccountChange[] @relation("AccountChangeRequester")
  changesReviewed  AccountChange[] @relation("AccountChangeReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
}

/// The buying entity — a clinic or laboratory, not the individual.
/// Trade accounts are held by the organisation and several people may order
/// against one.
model Organisation {
  id      String  @id @default(cuid())
  name    String
  /// Tax Registration Number. Required on a UAE tax invoice — see AC-03.
  trn     String?
  phone   String?
  emirate String?

  /// paymentTerms: Prepaid | Net7 | Net30 | Net60
  paymentTerms    String  @default("Prepaid")
  creditLimitFils Int     @default(0)
  isDisabled      Boolean @default(false)

  /// Standing notes about the account, shown on every order they place —
  /// "deliveries only before 11am", "PO required on every order". The kind of
  /// thing that is otherwise learnt once and forgotten.
  notes String?

  users     User[]
  addresses Address[]
  orders    Order[]
  staff     OrganisationStaff[]
  changes   AccountChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A change a customer made — or wants to make — to their own account.
///
/// One model rather than two, because the question a customer asks is the
/// same either way: what has been changed here, by whom, and why. Splitting
/// changes that took effect from changes waiting on us would mean two
/// timelines to read and keep in step.
///
/// The reason is never optional. It is the one thing about a change that
/// cannot be reconstructed later from the data itself — the database will
/// always be able to say a branch was removed, and will never be able to say
/// the clinic closed.
model AccountChange {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// kind: StaffAdded | StaffRemoved | BranchAdded | BranchEdited |
  ///       BranchRemoved | AccountRenamed
  kind String

  /// What changed, in the customer's words, for the timeline.
  summary String

  /// Why, typed by the person making the change.
  reason String

  /// status: Applied | Pending | Approved | Rejected
  ///
  /// Applied is a change that took effect at once — the staff list, which the
  /// account owns outright. Pending, Approved and Rejected belong to changes
  /// held for an admin, because they move where goods are delivered or what
  /// name goes on an invoice.
  status String @default("Applied")

  /// The change itself, as JSON, for anything held until approval. Cleared on
  /// approval: from then on the record of what happened is the database.
  payload String?

  /// What the change is about, so a branch can show its own pending edit
  /// beside it rather than only in a list somewhere else.
  targetId String?

  requestedByUserId String?
  requestedByUser   User?    @relation("AccountChangeRequester", fields: [requestedByUserId], references: [id])
  /// Snapshotted like every other name on a record — a person leaving the
  /// account must not blank the history of what they changed.
  requestedByName   String
  requestedAt       DateTime @default(now())

  reviewedByUserId String?
  reviewedByUser   User?     @relation("AccountChangeReviewer", fields: [reviewedByUserId], references: [id])
  reviewedByName   String?
  reviewedAt       DateTime?
  /// The admin's word on it. Required to reject, so "no" never arrives
  /// without a reason attached.
  decisionNote     String?

  @@index([organisationId, requestedAt])
  @@index([status])
  @@index([targetId])
}

model Address {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The branch name a customer with several sites recognises — "Jumeirah
  /// clinic", "Main store". An address is a branch: giving a practice with
  /// three sites a separate Branch concept beside this one would mean two
  /// things that mean the same, and orders already point here.
  label     String?
  contact   String
  phone     String
  line1     String
  line2     String?
  city      String
  emirate   String
  country   String  @default("United Arab Emirates")
  isDefault Boolean @default(false)

  /// Removed by the customer, not deleted. Orders already delivered there
  /// still name it, and a branch that closes must not blank its own history.
  isArchived Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())

  @@index([organisationId])
}

/// Someone at the customer who places orders.
///
/// A name, not a login. The question this answers is "who ordered this?", and
/// answering it does not need passwords, invitations or permissions — those
/// would be a different feature with a different cost. Promoting a name to a
/// real account later does not lose the history, because orders keep the name
/// they were placed under as a snapshot.
model OrganisationStaff {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name  String
  email String?
  /// Removed from the picker without touching the orders they placed.
  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())

  @@unique([organisationId, name])
  @@index([organisationId])
}

/// status: Active | Suspended
model Supplier {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  companyName    String
  /// Both addresses receive order notifications. secondaryEmail is mandatory
  /// at creation — a locked platform decision, enforced in the service layer
  /// since the column must stay nullable for existing rows.
  primaryEmail   String
  secondaryEmail String
  phone          String?
  address        String?
  /// Suppliers may invoice in their own name, so they need their own TRN.
  trn            String?
  status         String  @default("Active")

  /// Temporarily unable to supply anything at all — closed, suspended, on
  /// holiday. Every line where they are primary reverts to the backup while
  /// this is false. Distinct from status, which is a lasting classification
  /// rather than a this-week fact, and from ProductSupply.isAvailable, which
  /// takes out one item rather than the company. See DEC-25.
  isAvailable Boolean @default(true)

  /// What this supplier has committed to, agreed personally at onboarding —
  /// BE-33. "On time" is meaningless without a promise to measure against.
  promisedLeadTimeDays Int?
  /// How quickly they should acknowledge a purchase order, in hours.
  ackSlaHours          Int  @default(24)

  uploads        BulkUploadJob[]
  supplies       ProductSupply[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Self-referencing tree. Names MAY contain commas — nothing anywhere may
/// parse a category list by splitting on commas. That is what broke the old
/// platform's bulk upload.
model Category {
  id       String     @id @default(cuid())
  name     String
  /// Unique across the WHOLE tree, not just among siblings. Two categories
  /// sharing a slug makes one unreachable and the other answer to the wrong
  /// name — a real defect found during the rebuild.
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  imagePath String?

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Brand {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  products ProductMaster[]

  createdAt DateTime @default(now())
}

/// status: Draft | PendingApproval | Active | Inactive
///
/// A Supplier may create and edit their own products but may NEVER move one to
/// Active. Approval is Admin-only and enforced in the service layer, not just
/// hidden in the UI. approvedBy/approvedAt record who did it.
model ProductMaster {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  /// No supplierId. A product is not owned by a supplier — it has a primary
  /// and a backup, held per pack in ProductSupply with their own costs, lead
  /// times and part numbers (DEC-25). This field was also how supplier
  /// identity reached the browser in the first place, since it travelled into
  /// the catalogue with every product — see BE-38.
  status String @default("Draft")

  /// Variants are separate products that belong to one family — the same line
  /// in 375ml and 60ml, or in three glove sizes. Products sharing a
  /// variantGroup show each other in a dropdown, so a buyer landing on the
  /// wrong size can reach the right one without searching again.
  ///
  /// Deliberately NOT the ProductOption model: these are independently
  /// stocked, separately priced products with their own SKUs, not options on
  /// one product.
  variantGroup String?
  /// What distinguishes this member of the family, e.g. "375ml".
  variantLabel String?

  /// taxClass: Standard | ZeroRated
  /// Not every medical line is standard-rated. Charging 5% on a zero-rated
  /// product overstates a document the customer keeps — see AC-02.
  taxClass String @default("Standard")

  metaTitle       String?
  metaDescription String?

  createdBy  String?
  approvedBy String?
  approvedAt DateTime?

  skus       ProductSku[]
  categories ProductCategory[]
  images     ProductImage[]
  attributes ProductAttribute[]
  documents  ProductDocument[]
  options    ProductOption[]
  wishlisted WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([brandId])
  @@index([variantGroup])
}

model ProductCategory {
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productMasterId, categoryId])
  @@index([categoryId])
}

/// A purchasable unit of measure — this is what goes in a cart.
///
/// "100 Pieces/Box" and "10 Boxes/Carton" of the same product are two SKUs at
/// two prices. eachesPerPack lets a box and a carton be compared per unit.
model ProductSku {
  id              String        @id @default(cuid())
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  /// The supplier's own item code. Unique across the catalogue.
  skuCode String @unique

  /// The name of one base unit, e.g. "Each" or "Bottle". Price breaks are
  /// expressed as multiples of this.
  baseUnitName   String @default("Each")
  /// "100 Pieces/Box" — what the buyer sees on the unit selector.
  unitLabel      String
  /// "Box" — the short form shown beside Add to cart.
  unitShortLabel String
  /// How many base units this pack contains. 1 for the base pack.
  eachesPerPack  Int    @default(1)

  priceFils Int

  /// Set by an admin or supplier. When it flips back to false, every
  /// NotifySubscription for this SKU with notifiedAt = null is emailed.
  manualOutOfStock Boolean @default(false)

  /// Physical detail, used for shipping quotes later.
  weightGrams Int?
  barcode     String?

  isActive Boolean @default(true)

  tiers        PriceTier[]
  optionValues SkuOptionValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  quoteItems   QuoteItem[]
  notify       NotifySubscription[]
  batches      SkuBatch[]
  images       ProductImage[]
  supplies     ProductSupply[]
  poLines      PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productMasterId])
}

/// Who can supply this pack, and on what terms — DEC-25.
///
/// A product is not owned by a supplier. It has a primary supplier and a
/// backup, each with their own cost, lead time and part number, because they
/// are different companies selling the same thing. Tying the product to one
/// supplier made every product only as reliable as one company, and in a
/// cross-dock model a supplier who cannot supply means a customer waits a full
/// cycle.
///
/// This is also where cost lives, superseding the first half of BE-34: two
/// suppliers means two costs, so cost cannot sit on the SKU.
model ProductSupply {
  id       String     @id @default(cuid())
  skuId    String
  sku      ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// rank: Primary | Backup. One of each per SKU, enforced below.
  rank String

  /// What AussieMed pays this supplier for one pack, in fils. Never a float,
  /// and never visible outside the admin — a supplier seeing the markup on
  /// their own goods is a commercial problem, not merely a privacy one.
  ///
  /// Nullable on purpose. Cost arrives with the real catalogue, and a missing
  /// cost must read as "not recorded" rather than as zero, which would show a
  /// 100% margin on every product and be believed.
  costFils Int?

  /// What this supplier calls the item. Their picker works from their own
  /// catalogue, so the purchase order leads with this and carries our SKU
  /// alongside only as a reference.
  supplierPartNumber String?

  /// Overrides the supplier's default lead time for this item.
  leadTimeDays Int?

  /// This supplier cannot currently supply this particular item. Distinct from
  /// Supplier.isAvailable, which takes the whole company out — they are
  /// different situations and either one moves a line to the backup.
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, rank])
  @@unique([skuId, supplierId])
  @@index([supplierId])
}

/// Volume break: buying minQty or more drops the unit price.
///
/// Thresholds ascend and prices descend. The source data for the rebuild had
/// these entered backwards, so this is validated on write — see AC-01.
model PriceTier {
  id    String     @id @default(cuid())
  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  minQty    Int
  priceFils Int

  /// The packaging level this break represents — "Carton", "Box", "Pallet".
  /// A trade buyer does not order 12 because 12 is cheaper; they order a
  /// carton. Naming the level is the difference between a price list and a
  /// number that has to be explained.
  unitName      String?
  /// How many of the level below make this one, e.g. a box of 4 cartons.
  unitsPerLevel Int?

  @@unique([skuId, minQty])
  @@index([skuId])
}

/// A variant axis such as Size or Colour.
model ProductOption {
  id              String        @id @default(cuid())
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  values ProductOptionValue[]

  @@unique([productMasterId, name])
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value     String
  sortOrder Int    @default(0)

  skus SkuOptionValue[]

  @@unique([optionId, value])
}

/// Joins a SKU to the option values it represents, e.g. Size=Large.
model SkuOptionValue {
  skuId   String
  sku     ProductSku         @relation(fields: [skuId], references: [id], onDelete: Cascade)
  valueId String
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([skuId, valueId])
  @@index([valueId])
}

/// Structured specifications — material, standard, sterility, cuff length.
/// Trade buyers filter on these, so they are rows rather than prose.
model ProductAttribute {
  id              String        @id @default(cuid())
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  label     String
  value     String
  sortOrder Int    @default(0)

  @@index([productMasterId])
  @@index([label])
}

/// Safety data sheets and specification sheets. For laboratory and medical
/// buyers an SDS is frequently a compliance requirement, not a nicety.
model ProductDocument {
  id              String        @id @default(cuid())
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  label     String
  path      String
  /// kind: SDS | Specification | Certificate | Flyer
  kind      String @default("Specification")
  sortOrder Int    @default(0)

  @@index([productMasterId])
}

model ProductImage {
  id              String        @id @default(cuid())
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)
  /// Optional: an image specific to one SKU, e.g. the black glove.
  skuId           String?
  sku             ProductSku?   @relation(fields: [skuId], references: [id])

  path      String
  altText   String?
  sortOrder Int     @default(0)

  @@index([productMasterId])
}

/// Batch and expiry. Medical stock expires, and short-dated stock is commonly
/// sold at a discount. Optional — a SKU with no batches simply has none
/// tracked. Included now because adding it later means backfilling every
/// movement, which is the expensive kind of change. See FN-09.
model SkuBatch {
  id    String     @id @default(cuid())
  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  batchCode          String
  expiresOn          DateTime?
  quantity           Int       @default(0)
  /// Overrides the SKU price while this batch is being cleared.
  clearancePriceFils Int?

  createdAt DateTime @default(now())

  @@unique([skuId, batchCode])
  @@index([expiresOn])
}

// ---------------------------------------------------------------------------
// Cart, quotes and wishlist
// ---------------------------------------------------------------------------

/// cartKey supports guest carts held in a cookie; on sign-in the guest cart
/// merges into the user's.
model Cart {
  id      String  @id @default(cuid())
  cartKey String  @unique
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CartItem {
  id     String     @id @default(cuid())
  cartId String
  cart   Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  skuId  String
  sku    ProductSku @relation(fields: [skuId], references: [id])

  /// Integer, at least 1. Quantities are never fractional.
  qty Int

  createdAt DateTime @default(now())

  /// One line per SKU. A box and a carton are different SKUs and stay
  /// separate lines; the same SKU added twice merges.
  @@unique([cartId, skuId])
  @@index([skuId])
}

model WishlistItem {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productMasterId String
  product         ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productMasterId])
  @@index([productMasterId])
}

/// status: New | Quoted | Accepted | Declined | Expired
model QuoteRequest {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  reference    String  @unique
  contactName  String
  contactEmail String
  notes        String?
  status       String  @default("New")

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteItem {
  id      String       @id @default(cuid())
  quoteId String
  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  skuId   String
  sku     ProductSku   @relation(fields: [skuId], references: [id])

  qty             Int
  /// Filled in when the team responds; null while the quote is open.
  quotedPriceFils Int?

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// status: Pending | Processing | Dispatched | Delivered | Cancelled
///
/// Customer-facing wording is always "reference number", never "order number".
model Order {
  id        String @id @default(cuid())
  reference String @unique

  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  /// The cart that placed a guest order, so a guest can read their own order
  /// back without an account. Never exposed to the client.
  guestCartKey String?

  addressId        String?
  address          Address? @relation(fields: [addressId], references: [id])

  /// Who at the customer placed it. The name is snapshotted alongside the
  /// link, like every other name on an order, so removing a staff member does
  /// not blank the orders they placed.
  staffId      String?
  staff        OrganisationStaff? @relation(fields: [staffId], references: [id])
  placedByName String?
  /// The delivery address as it was at the time, so later edits to the
  /// address book cannot rewrite a historical order.
  shippingSnapshot String?

  status        String  @default("Pending")
  /// paymentMethod: OfflinePurchaseOrder | Card | BankTransfer
  paymentMethod String  @default("OfflinePurchaseOrder")
  poReference   String?

  /// Payment is tracked apart from fulfilment because on credit terms the two
  /// are genuinely independent: a Net 30 order ships today and is paid a month
  /// later, and a prepaid one is paid before anything is picked.
  ///
  /// paymentStatus: Unpaid | PartiallyPaid | Paid | Overdue | Refunded
  paymentStatus String    @default("Unpaid")
  paidAt        DateTime?
  paidFils      Int       @default(0)
  /// Taken from the account's terms when the order is placed, then stored —
  /// later changes to those terms must not move the due date on an invoice
  /// already issued.
  paymentDueOn  DateTime?

  /// deliveryType: Delivery | PickUp
  deliveryType        String    @default("Delivery")
  deliveryPriceFils   Int       @default(0)
  estimatedShipmentOn DateTime?
  trackingNumber      String?
  courier             String?

  subtotalFils       Int
  vatFils            Int
  totalFils          Int
  /// The VAT rate in force when the order was placed, in basis points (500 =
  /// 5%). Stored so a future rate change cannot rewrite historical orders.
  vatRateBasisPoints Int @default(500)

  items OrderItem[]

  /// Staff-only. Customer-visible notes belong to the user and organisation;
  /// this is what the warehouse and accounts write to each other.
  internalNotes String?

  /// What the customer typed at checkout — a delivery instruction, a ward
  /// name, a "please call before delivering". Distinct from internalNotes so
  /// nobody has to guess which of the two the customer can see.
  customerNotes String?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organisationId])
  @@index([status])
}

/// OrderSupplierInvoice was removed on 16 Aug 2026.
///
/// It split a customer's order into one invoice per supplier, which was right
/// for a marketplace and is wrong for what AussieMed turned out to be. Under
/// DEC-22 AussieMed is the seller of record and issues one invoice; under
/// DEC-24 the customer never learns a supplier was involved at all.
///
/// The split has not been lost, it has moved to where it belongs: buying now
/// happens after the order, through the daily consolidated purchase orders,
/// and PurchaseAllocation links what arrived back to the customers waiting.
/// That is a better record than the old one — it knows which units, from which
/// delivery, in which lot, rather than only which supplier.

model OrderItem {
  id      String     @id @default(cuid())
  orderId String
  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId   String
  sku     ProductSku @relation(fields: [skuId], references: [id])

  /// Copied at order time. A later price change or rename must never alter a
  /// historical order line.
  nameSnapshot      String
  skuCodeSnapshot   String
  unitLabelSnapshot String
  taxClassSnapshot  String

  qty           Int
  unitPriceFils Int
  lineTotalFils Int
  vatFils       Int

  /// Per-line fulfilment. An order is rarely one thing: half the lines ship
  /// today while one waits on a supplier, and a single order-level status
  /// cannot express that.
  ///
  /// status: Pending | Allocated | Picked | Packed | Shipped | Backordered | Cancelled
  status String @default("Pending")

  /// Lot traceability. For medical and dental consumables this is not
  /// optional: a recall must be answerable with "which customers received
  /// batch X", and only the order line can answer it.
  batchCodeSnapshot String?
  expiresOnSnapshot DateTime?

  /// Warehouse-facing. Never shown to the customer.
  internalNotes String?

  /// What has been bought for this line and physically received against it.
  /// Under cross-dock, Allocated stops meaning reserved from stock and starts
  /// meaning received at the sorting facility and assigned to this customer.
  allocations PurchaseAllocation[]

  @@index([orderId])
  @@index([batchCodeSnapshot])
  @@index([skuId])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// Restock alert. When a SKU's manualOutOfStock flips false, everyone here
/// with notifiedAt = null is emailed and then stamped.
/// Someone waiting for a product to come back — FN-04.
///
/// Keyed on email rather than on an account, because most people who ask are
/// not signed in and requiring an account to be told about stock would lose
/// most of the demand this exists to capture. When they are signed in the
/// account is linked too, so the admin can see who is waiting.
model NotifySubscription {
  id    String     @id @default(cuid())
  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  email  String
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([skuId, email])
  @@index([notifiedAt])
  @@index([userId])
}

/// A bulk-buy or volume-pricing enquiry — FN-03.
///
/// These are the highest-intent visitors on the site: a clinic asking for a
/// price on volume. They were reaching nobody. Stored rather than emailed,
/// because email is BE-05 and unbuilt, and an enquiry sitting in a queue
/// someone can read is worth more than one sent to an address that does not
/// exist yet. When email arrives it sends from these rows.
model Enquiry {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  /// kind: BulkBuy — contact and support forms can join this later.
  kind String @default("BulkBuy")

  company     String?
  contactName String
  email       String
  phone       String?
  /// What they asked for, as they wrote it. Free text on purpose: a clinic
  /// listing "3 boxes of the blue nitrile, medium" is more useful to read than
  /// it would be forced into a product picker.
  message     String

  /// status: New | Answered | Closed
  status      String  @default("New")
  answeredAt  DateTime?
  /// Staff-only notes about the conversation.
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// status: Pending | Processing | Completed | Failed
model BulkUploadJob {
  id         String    @id @default(cuid())
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  uploadedBy String
  filename   String
  status     String @default("Pending")

  rowsTotal   Int @default(0)
  rowsCreated Int @default(0)
  rowsSkipped Int @default(0)
  rowsErrored Int @default(0)

  rows BulkUploadRow[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([supplierId])
}

/// outcome: Created | Updated | Skipped | Error
///
/// A skipped row always carries a reason. The old platform dropped rows with
/// unknown brands silently, which is how data went missing without anyone
/// noticing.
model BulkUploadRow {
  id    String        @id @default(cuid())
  jobId String
  job   BulkUploadJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  rowNumber       Int
  outcome         String
  message         String?
  productMasterId String?

  @@index([jobId])
}

/// Every status transition and every admin or supplier write.
/// before/after hold JSON as text for datasource portability.
model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String?
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id])

  action   String
  entity   String
  entityId String
  before   String?
  after    String?

  at DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

/// One consolidated order to one supplier for one day — DEC-26.
///
/// Customer orders accumulate through the day; at the cutoff every unpurchased
/// line is grouped by supplier and quantities are summed per item, so a
/// supplier receives one order for fifty gloves rather than eleven orders for
/// gloves. Pooling is the point: it is what makes the quantities worth pricing.
///
/// This document must never carry a customer name, address, order reference or
/// even a count of customers. That is not a detail of the layout, it is the
/// model — see SEC-05, and test it rather than assume it.
model PurchaseOrder {
  id         String   @id @default(cuid())
  poNumber   String   @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// status: Draft | Sent | Acknowledged | Dispatched | PartiallyReceived | Received | Cancelled
  ///
  /// Sent, Acknowledged and Dispatched are the supplier's to set; the receiving
  /// statuses are ours, because only the sorting facility knows what arrived.
  status String @default("Draft")

  /// The cutoff this batch covers. Anything ordered after it belongs to the
  /// next purchase order, which is what makes the boundary reproducible.
  cutoffAt DateTime

  sentAt         DateTime?
  /// Set once, by the supplier, and never moved afterwards — a second click
  /// must not rewrite how quickly they responded.
  acknowledgedAt DateTime?
  dispatchedAt   DateTime?
  expectedAt     DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?

  /// What the supplier tells us is on its way, for the sorting facility to
  /// expect. Their own reference, not ours.
  courier        String?
  trackingNumber String?

  /// What AussieMed expects to pay, in fils. Sell prices never appear here.
  totalCostFils Int @default(0)

  /// Staff-only. Never sent to the supplier.
  internalNotes String?
  /// Written on the document the supplier receives.
  supplierNotes String?

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([cutoffAt])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id])

  /// Snapshotted like every other document line: what the supplier called it
  /// and what it cost on the day. Renegotiating a price later must not rewrite
  /// a purchase order already sent.
  supplierPartNumberSnapshot String?
  nameSnapshot               String
  skuCodeSnapshot            String
  unitCostFilsSnapshot       Int

  qtyOrdered  Int
  qtyReceived Int @default(0)

  /// True when this line fell back from the primary supplier, so a reviewer can
  /// see at a glance which lines were not the first choice.
  wasFallback Boolean @default(false)

  lineCostFils Int

  allocations PurchaseAllocation[]

  @@index([purchaseOrderId])
  @@index([skuId])
}

/// Which received units belong to which customer — BE-37.
///
/// The keystone of the cross-dock model. Goods arrive pooled by item with no
/// idea who they are for; this is the record that assigns them, on our side of
/// the wall, so a recalled batch can be traced to the exact clinics that
/// received it while the supplier still never learns a customer existed.
///
/// It is also what makes a short delivery expressible: three of five units
/// received means three allocations and two order lines still waiting.
model PurchaseAllocation {
  id                  String            @id @default(cuid())
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  qty Int

  /// Recorded at goods-in, against what physically arrived, then copied onto
  /// the order line. Lot traceability for medical consumables is not optional:
  /// a recall must be answerable with "which customers received batch X".
  batchCode String?
  expiresOn DateTime?

  allocatedBy String?
  allocatedAt DateTime @default(now())

  @@index([purchaseOrderLineId])
  @@index([orderItemId])
  @@index([batchCode])
}

/// Key/value configuration — VAT rate, email templates, general settings.
/// Kept as rows so an admin can change them without a deploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A signed-in session.
///
/// The cookie holds only this row's random token; nothing about the user is
/// trusted from the browser. Deleting the row signs the session out
/// everywhere, which a stateless JWT could not do.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
