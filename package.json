{
  "name": "aussiemed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/build-catalog.mjs",
    "check": "node scripts/check-catalog.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "verify": "npm run data:build && npm run check && npm run register && npm run test && npm run typecheck",
    "smoke": "node scripts/smoke-api.mjs",
    "register": "node scripts/register.mjs --md && node scripts/build-spreadsheet.mjs"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "exceljs": "^4.4.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
