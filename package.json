{
  "name": "aussiemed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "data:build": "node scripts/build-catalog.mjs",
    "check": "node scripts/check-catalog.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "verify": "npm run data:build && npm run check && npm run register && npm run test && npm run typecheck",
    "smoke": "node scripts/smoke-api.mjs",
    "check:privacy": "node scripts/check-supplier-privacy.mjs",
    "register": "node scripts/register.mjs --md && node scripts/build-spreadsheet.mjs",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:check": "node --experimental-strip-types scripts/check-db.ts",
    "db:seed:accounts": "node --experimental-strip-types prisma/seed-accounts.ts",
    "db:seed:orders": "node --experimental-strip-types prisma/seed-order-states.ts",
    "db:seed:categories": "node --experimental-strip-types prisma/seed-categories.ts",
    "db:seed:samples": "node --experimental-strip-types prisma/seed-samples.ts",
    "flags:build": "node --experimental-strip-types scripts/build-flags.mjs",
    "subdivisions:build": "node --experimental-strip-types scripts/build-subdivisions.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "^16.3.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "country-region-data": "^4.1.0",
    "exceljs": "^4.4.0",
    "flag-icons": "^7.5.0",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
